{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
