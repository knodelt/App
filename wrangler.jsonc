{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./main-worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HIDDEN_MATCH_ROOMS",
        "class_name": "HiddenMatchRoom"
      },
      {
        "name": "FRAME_ACCOUNTS",
        "class_name": "FrameAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "hidden_match_v1",
      "new_sqlite_classes": [
        "HiddenMatchRoom"
      ]
    },
    {
      "tag": "frame_accounts_v1",
      "new_sqlite_classes": [
        "FrameAccount"
      ]
    }
  ]
}
